{
  "name": "shikhon-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Shikhon (شيخون) - Bilingual Car Spare Parts Showcase Platform with Apple visionOS Liquid Glass aesthetic",
  "scripts": {
    "dev:web": "npm run dev --prefix web-showcase",
    "dev:admin": "npm run dev --prefix desktop-admin",
    "dev:electron": "npm run electron --prefix desktop-admin",
