{
  "openapi": "3.0.3",
  "info": {
    "title": "Shikhon Auto Spare Parts API",
    "description": "Comprehensive REST API documentation for the Shikhon automotive spare parts platform. Includes PostgREST product endpoints, Supabase Storage for direct image management, and Supabase Auth for admin authentication.",
    "version": "v1.1",
    "contact": {
      "name": "Shikhon Platform Engineering",
      "email": "support@shikhon.com"
    },
    "license": {
      "name": "MIT License"
    }
  },
  "servers": [
    {
      "url": "https://ugmtruurtlyieptuzhar.supabase.co",
      "description": "Live Supabase Cloud (shikhon)"
    },
    {
      "url": "http://127.0.0.1:54321",
      "description": "Local Supabase CLI Instance"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/auth/v1/token?grant_type=password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "1. Log in admin (obtain JWT access token)",
        "operationId": "auth_login_post",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              },
              "example": {
                "email": "admin@shikhon-parts.com",
                "password": "YourAdminPassword2026!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT access token returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login credentials"
          }
        }
      }
    },
    "/auth/v1/signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "2. Register new admin account (Sign up)",
        "operationId": "auth_signup_post",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              },
              "example": {
                "email": "newadmin@shikhon-parts.com",
                "password": "StrongPassword123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Registration error"
          }
        }
      }
    },
    "/auth/v1/user": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "3. Get current admin user profile",
        "operationId": "auth_user_read",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile data"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/rest/v1/products": {
      "get": {
        "tags": [
          "Products (Catalog & Admin)"
        ],
        "summary": "4. Fetch all car spare parts (Public & Dashboard)",
        "description": "Retrieves spare parts catalog ordered by creation date. Used by the Web Showcase and Desktop Dashboard.",
        "operationId": "products_list",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "description": "Columns to select (* for all)",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Ordering clause",
            "required": false,
            "schema": {
              "type": "string",
              "default": "created_at.desc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Row limit",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of spare parts returned as JSON array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer access token"
          }
        }
      },
      "post": {
        "tags": [
          "Products (Catalog & Admin)"
        ],
        "summary": "5. Create new spare part (POST)",
        "description": "Inserts a new spare part record into the products table.",
        "operationId": "products_create",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "return=representation"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              },
              "example": {
                "name_ar": "OEM Alternator Belt",
                "name_en": "Genuine Alternator Belt",
                "image_url": "https://ugmtruurtlyieptuzhar.supabase.co/storage/v1/object/public/product-images/belt.jpg",
                "category": "Engine",
                "part_number": "ENG-BLT-900",
                "price": 35.0,
                "in_stock": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "patch": {
        "tags": [
          "Products (Catalog & Admin)"
        ],
        "summary": "6. Update spare part details by ID (PATCH)",
        "operationId": "products_partial_update",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "8b9f7cc7-bfdc-442f-94b3-527db8bc6eb4",
            "description": "Product UUID (e.g. 8b9f7cc7-bfdc-442f-94b3-527db8bc6eb4)"
          },
          {
            "name": "Prefer",
            "in": "header",
            "schema": {
              "type": "string",
              "default": "return=representation"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              },
              "example": {
                "name_ar": "OEM Alternator Belt - Updated",
                "price": 38.5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Products (Catalog & Admin)"
        ],
        "summary": "7. Delete spare part by ID (DELETE)",
        "operationId": "products_delete",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "8b9f7cc7-bfdc-442f-94b3-527db8bc6eb4",
            "description": "Product UUID (e.g. 8b9f7cc7-bfdc-442f-94b3-527db8bc6eb4)"
          }
        ],
        "responses": {
          "200": {
            "description": "Product deleted successfully"
          },
          "204": {
            "description": "Deleted with no content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/storage/v1/object/product-images/{filename}": {
      "post": {
        "tags": [
          "Storage (Image Management)"
        ],
        "summary": "8. Upload spare part image (POST binary)",
        "description": "Direct upload to the public bucket 'product-images'. Header x-upsert: true overwrites existing file.",
        "operationId": "storage_upload_image",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "brake-disc.jpg"
          },
          {
            "name": "x-upsert",
            "in": "header",
            "schema": {
              "type": "string",
              "default": "true"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image uploaded successfully",
            "content": {
              "application/json": {
                "example": {
                  "Key": "product-images/brake-disc.jpg",
                  "Id": "2cfdbf1f-81c0-4eea-8f29-19cc4d9f213a"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "Key": {
                      "type": "string",
                      "example": "product-images/brake-disc.jpg"
                    },
                    "Id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "2cfdbf1f-81c0-4eea-8f29-19cc4d9f213a"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer access token"
          }
        }
      },
      "delete": {
        "tags": [
          "Storage (Image Management)"
        ],
        "summary": "9. Delete spare part image from storage (DELETE)",
        "operationId": "storage_delete_image",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "brake-disc.jpg"
          }
        ],
        "responses": {
          "200": {
            "description": "Image deleted successfully"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer access token"
          }
        }
      }
    },
    "/storage/v1/object/public/product-images/{filename}": {
      "get": {
        "tags": [
          "Storage (Image Management)"
        ],
        "summary": "10. View / Download public image CDN URL (GET)",
        "operationId": "storage_get_public_image",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "brake-disc.jpg"
          }
        ],
        "responses": {
          "200": {
            "description": "Image binary returned"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer access token"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT access token obtained from /auth/v1/token. Sent automatically in the Authorization header as Bearer <token>."
      }
    },
    "schemas": {
      "AuthLoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@shikhon-parts.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "YourPassword123!"
          }
        }
      },
      "AuthLoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          },
          "user": {
            "type": "object"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name_ar",
          "name_en",
          "image_url",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name_ar": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "in_stock": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": [
          "name_ar",
          "name_en",
          "image_url"
        ],
        "properties": {
          "name_ar": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "in_stock": {
            "type": "boolean"
          }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name_ar": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "in_stock": {
            "type": "boolean"
          }
        }
      }
    }
  }
}